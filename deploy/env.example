# Copy to deploy/.env on the server (gcp-vm.sh does this for you). Never commit the real file.

# Public hostname. Without a domain, use <ip-with-dashes>.sslip.io, e.g. 34-12-56-78.sslip.io.
PICASSO_DOMAIN=

# Workspace ids (Settings -> Account -> Workspace ID) allowed to sign in with a Claude-account token.
# Everyone else signs in with an Anthropic API key. Empty = anyone may use either.
PICASSO_CLAUDE_ACCOUNT_ALLOWLIST=

# Needed to create a new workspace (returning users don't need it). Empty = open sign-up.
PICASSO_INVITE_CODE=

# Footage libraries (optional; Wikimedia, NASA and the Internet Archive need no key).
PIXABAY_API_KEY=
PEXELS_API_KEY=

# Media storage in Tigris (optional; without it everything stays on the server's disk).
# The access key needs Editor (read/write) access to the bucket.
TIGRIS_ACCESS_KEY_ID=
TIGRIS_SECRET_ACCESS_KEY=
TIGRIS_BUCKET=
# TIGRIS_ENDPOINT=https://t3.storage.dev
